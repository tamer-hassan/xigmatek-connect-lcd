#!/bin/bash
# Post-install checks for xigmatek-connect-lcd: the things only measurable once the
# package has been unpacked into the layout an install produces.  Runs under
# autopkgtest (debian/tests/control) and by hand on any installed system:
#
#     sudo apt install ./../xigmatek-connect-lcd_*_all.deb
#     debian/tests/smoke
#
# Deliberately never opens a serial port: the render goes to a PNG in a temporary
# directory, so this is safe on a box where the panel is absent, busy, or unhealthy.
set -euo pipefail

# Not the source tree: if the current directory held xigmalcd/, `import xigmalcd`
# would import the copy sitting next to us and prove nothing about the install.
here=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cd /

say() { printf '  %-21s %s\n' "$1" "$2"; }

echo "== the modules are where the interpreter looks"
where=$(python3 - <<'PY'
import os, xigmalcd.protocol, xigmaui.clips
print(os.path.dirname(os.path.abspath(xigmalcd.protocol.__file__)))
PY
)
case "$where" in
    /usr/lib/python3/dist-packages/xigmalcd) ;;
    *) echo "  imported from $where, not dist-packages: FAILED"; exit 1 ;;
esac
say "imports" "$where (+ xigmaui)"

echo
echo "== the two commands that draw, from pyproject.toml's entry points"
# `xigmalcd-reset` is the third entry point and is checked in its own section below,
# because what matters about it is not that it exists but that it sends nothing
# without --yes.  Both halves add up to the three scripts pyproject.toml declares;
# the end of this file asserts that nothing else landed in /usr/bin.
for cmd in xigmalcd xigmaui; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "  $cmd not on PATH: FAILED"; exit 1
    fi
done
xigmalcd --help >"$work/help.txt"
grep -q -- '--fps' "$work/help.txt" || { echo "  xigmalcd --help: FAILED"; exit 1; }
say "xigmalcd" "$(command -v xigmalcd), --help $(wc -c <"$work/help.txt") B"
if python3 -c "import PyQt6" >/dev/null 2>&1; then
    xigmaui --help >"$work/ghelp.txt"
    grep -q -- '--tray' "$work/ghelp.txt" || { echo "  xigmaui --help: FAILED"; exit 1; }
    say "xigmaui" "$(command -v xigmaui), --help $(wc -c <"$work/ghelp.txt") B"
else
    # PyQt6 is a Suggest, not a Depends: the display loop needs no Qt.  The command
    # is still there (it comes from pyproject.toml's entry points), so say which of
    # the two reasons it could not run is the one we are in.
    say "xigmaui" "$(command -v xigmaui) present; SKIPPED --help, no PyQt6 (Suggest)"
fi

echo
echo "== the clips the package installed are the ones the code finds"
# $XIGMA_MEDIA unset and no checkout in the picture: /usr/share/xigmalcd/media has to
# answer on its own, which is exactly the case that was broken before the roots were
# made installation-aware (xigmalcd/main.py:media_roots).  md5 is the vendor's own
# clip, the same value tools/selftest.sh pins from a checkout.
test -z "${XIGMA_MEDIA:-}" || { echo "  XIGMA_MEDIA is set; unset it for this test"; exit 1; }
python3 - <<'PY'
import hashlib, os
from xigmalcd import main as m

assert m.SYSTEM_MEDIA == "/usr/share/xigmalcd/media", m.SYSTEM_MEDIA
# The rule, not one box's directory list: the media root first, and the theme library after
# it if the themes package put it there.  This line used to read
# `media_roots() == ("/usr/share/xigmalcd/media",)`, and it went red on CI the day this
# section started actually running - which was the day the themes .deb began being installed
# on a push as well as on a tag.  An assert that describes a box with no themes package, in
# the section whose subject is a box that has one, was always waiting to fail.
_want_roots = [m.SYSTEM_MEDIA]
if os.path.isdir(m.SYSTEM_CLIP_LIB):
    _want_roots.append(m.SYSTEM_CLIP_LIB)
assert list(m.media_roots()) == _want_roots, (m.media_roots(), _want_roots)
want = {"Theme_25.mp4": (214_917, "b818b7d3294b3625e9f143e920ccc9b0"),
        "Theme_11.mp4": (3_402_098, "4a515a8a17204ffb5a23d2ac34dd37ee"),
        "theme_48.mp4": (1_333_649, "51701687804f60875da872c7f27ad673")}
got = sorted(os.listdir(m.SYSTEM_MEDIA))
assert got == sorted(want), got
for name, (size, md5) in want.items():
    blob = open(os.path.join(m.SYSTEM_MEDIA, name), "rb").read()
    assert len(blob) == size, (name, len(blob), size)
    assert hashlib.md5(blob).hexdigest() == md5, name
    assert blob[4:8] == b"ftyp", blob[:12]
for const, name in (("DEFAULT_MP4", "Theme_25.mp4"), ("QUIET_MP4", "Theme_11.mp4"),
                    ("BRIGHT_MP4", "theme_48.mp4")):
    path = getattr(m, const)
    assert path == os.path.join(m.SYSTEM_MEDIA, name), (const, path)
    print(f"  {const:11s} {path}")
# A library name answers through the same function, on the box that installed the package:
# `--mp4 Theme_07.mp4` is the background the layout of that name declares.  The three clips
# the main package vendors still resolve in media/, which is the precedence the default
# depends on - both halves are checked here, not just the one that got easier.
_lib = sorted(n for n in os.listdir(m.SYSTEM_CLIP_LIB) if n.endswith(".mp4")) \
    if os.path.isdir(m.SYSTEM_CLIP_LIB) else []
if _lib:
    _only = [n for n in _lib if not os.path.exists(os.path.join(m.SYSTEM_MEDIA, n))]
    assert _only, "every clip in the installed theme library is also a vendored one"
    _got = m.find_media(_only[0])
    assert _got == os.path.join(m.SYSTEM_CLIP_LIB, _only[0]), (_only[0], _got)
    for name in want:
        assert m.find_media(name) == os.path.join(m.SYSTEM_MEDIA, name), name
    print(f"  name lookup   {len(_lib)} clips in the installed library: {_only[0]} answers "
          f"from {_want_roots[-1]}, and the three vendored clips still answer from media/")
print(f"  roots         {m.media_roots()}")
PY
say "vendored clips" "3 clips, sizes and md5 as pinned in tools/selftest.sh"

echo
echo "== one frame, drawn with no panel in the loop"
# --dry-run is the same render path the loop uses; --once keeps it to one PNG and one
# exit code.  A missing font or a missing clip shows up here as a failed exit or a
# short file rather than as a blank panel in someone's kitchen.
xigmalcd --dry-run "$work/frames" --once >"$work/dry.log" 2>&1 || {
    cat "$work/dry.log"; echo "  xigmalcd --dry-run: FAILED"; exit 1; }
python3 - "$work/frames" <<'PY'
import glob, sys
from PIL import Image
files = sorted(glob.glob(sys.argv[1] + "/*.png"))
assert len(files) == 1, files
im = Image.open(files[0])
assert im.size == (480, 480), im.size
print(f"  frame           {files[-1]} {im.size[0]}x{im.size[1]} {im.mode} "
      f"{__import__('os').path.getsize(files[-1])} B")
PY
say "dry-run" "480x480 PNG written, exit 0"

echo
echo "== what debhelper installed around it"
rule=/usr/lib/udev/rules.d/99-xigmatek-lcd.rules
test -f "$rule" || { echo "  missing $rule: FAILED"; exit 1; }
grep -q 'idVendor}=="1d6b"' "$rule" && grep -q 'Xigmatek USB Device' "$rule" \
    || { echo "  $rule does not name the panel: FAILED"; exit 1; }
say "udev rule" "$rule (symlink xigmatek-lcd, TAG+=uaccess)"

unit=/usr/lib/systemd/user/xigmalcd.service
test -f "$unit" || { echo "  missing $unit: FAILED"; exit 1; }
exec_line=$(sed -n 's/^ExecStart=//p' "$unit")
[ -n "$exec_line" ] || { echo "  no ExecStart in $unit: FAILED"; exit 1; }
prog=${exec_line%% *}
[ -x "$prog" ] || { echo "  ExecStart names $prog, not executable: FAILED"; exit 1; }
# The gate is on ExecStart, not on the file: this unit's prose names --allow-reset to
# explain why it is not used, so a whole-file grep is the wrong test (the first
# version of this check failed on a unit that ships the flag nowhere).  What matters
# is that the command systemd runs cannot reach the vendor's `recovery`, which
# re-enumerates the USB device and drops the panel's stored background; nothing that
# starts at login may be one socket write away from that.  debian/xigmalcd.service
# explains the gate.
case "$exec_line" in
    *--allow-reset*)
        echo "  $unit ExecStart arms --allow-reset: FAILED"
        exit 1 ;;
esac
say "user unit" "$unit -> $exec_line (no --allow-reset)"

# Where the enablement lives, reported rather than asserted.  The package enables the
# unit through deb-systemd-helper, whose symlink lands in
# /etc/systemd/user/default.target.wants - what systemd calls global user scope, for
# every user's next login - so the command that works in a checkout, `systemctl --user
# disable --now xigmalcd`, is the one that here only prints a warning.  A reader of an
# autopkgtest log should be able to see which scope the installed system is in;
# docs/packaging.md explains the difference and the command that does act.
if systemctl --user is-active --quiet xigmalcd 2>/dev/null; then
    say "unit state" "active: the display is running, and it is the holder of the port"
else
    userv=$(systemctl --user is-enabled xigmalcd 2>/dev/null || echo unknown)
    global=$(systemctl --global is-enabled xigmalcd 2>/dev/null || echo unknown)
    printf '  %-18s %s\n' "unit state" "inactive; is-enabled --user=$userv, --global=$global"
    printf '  %-18s %s\n' "" "global scope = /etc/systemd/user; undo with: sudo systemctl --global disable xigmalcd"
fi

desk=/usr/share/applications/xigmaui.desktop
if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "$desk" || { echo "  $desk: FAILED"; exit 1; }
    say "menu entry" "$desk, desktop-file-validate clean"
else
    say "menu entry" "$desk present; desktop-file-validate not installed (SKIPPED)"
fi

icon=/usr/share/icons/hicolor/256x256/apps/xigmaui.png
test -f "$icon" || { echo "  missing $icon: FAILED"; exit 1; }
python3 - "$icon" <<'PY'
import os, sys
from PIL import Image
im = Image.open(sys.argv[1])
assert im.size == (256, 256) and im.mode == "RGBA", (im.size, im.mode)
assert all(im.getpixel(xy)[3] == 0 for xy in ((0, 0), (255, 0), (0, 255), (255, 255)))
print(f"  icon            {sys.argv[1]} {im.size[0]}x{im.size[1]} "
      f"{im.mode} {os.path.getsize(sys.argv[1])} B, corners transparent")
PY
# Whether the theme name resolves is a property of the desktop session's icon cache
# (dh_icons installs the file and asks for the cache to be updated; a headless box
# may never run that), so it is reported, not asserted.
if python3 -c "import PyQt6" >/dev/null 2>&1; then
    resolves=$(QT_QPA_PLATFORM=offscreen python3 - <<'PY' 2>/dev/null || echo unknown
from PyQt6.QtGui import QIcon
from PyQt6.QtWidgets import QApplication
app = QApplication([])
print("yes" if QIcon.fromTheme("xigmaui").isNull() is False else "no")
PY
)
    say "Icon=xigmaui" "resolves by theme name: ${resolves:-unknown} (informational)"
fi

echo
echo "== the reset command, and the gate on it"
# `recovery` re-enumerates the USB device and drops the panel's stored background, so
# the command that sends it is in the package only as a thing a person types, and only
# with --yes (xigmalcd/reset.py).  Run here without --yes, against a port that is not
# there: it must print the frame and send nothing, exit 0, and leave no device open.
reset=/usr/bin/xigmalcd-reset
test -x "$reset" || { echo "  missing $reset: FAILED"; exit 1; }
rc=0
"$reset" --device /nonexistent-port >"$work/reset.txt" 2>&1 || rc=$?
[ "$rc" -eq 0 ] || { echo "  dry run exited $rc: FAILED"; cat "$work/reset.txt"; exit 1; }
grep -q 'dry run: nothing sent' "$work/reset.txt" \
    || { echo "  dry run did not say it sent nothing: FAILED"; cat "$work/reset.txt"; exit 1; }
grep -q 'frame to send (109 bytes)' "$work/reset.txt" \
    || { echo "  the frame printed is not the 109-byte one PROTOCOL.md quotes: FAILED"; exit 1; }
if grep -q -- '--yes' <<<"$(sed -n 's/^ExecStart=//p' "$unit")"; then
    echo "  $unit passes --yes: FAILED"; exit 1
fi
say "xigmalcd-reset" "$reset; no --yes -> $(wc -c <"$work/reset.txt") B printed, nothing sent"

echo
echo "== what the package does NOT ship"
# The discovery and probe scripts in tools/ put deliberately wrong or unmeasured
# bodies on the wire to see what the firmware accepts.  Those stay on the bench.
for path in /usr/bin/reset_panel /usr/bin/reset_panel.py /usr/bin/probe \
            /usr/bin/fuzz /usr/bin/keyprobe /usr/bin/send_image \
            /usr/share/xigmalcd/tools; do
    if [ -e "$path" ]; then echo "  $path exists in the install: FAILED"; exit 1; fi
done
say "tools/" "not installed; only the three entry points are on PATH"

echo
echo "== the documents, and the links between them"
# README.md is the short page and docs/*.md carry the detail, which means an installed
# system has to have both for the prose to be readable: the overview's links are written
# `docs/x.md` because that is what works in a checkout and on GitHub, so the package
# installs the markdown as a docs/ tree (debian/rules) and keeps it uncompressed
# (override_dh_compress, or dh_compress would leave a reader with README.md.gz pointing
# at usage.md.gz and break every link in the tree).
docdir=/usr/share/doc/xigmatek-connect-lcd
python3 - "$docdir" <<'PY' || { echo "  documents: FAILED"; exit 1; }
import os
import re
import sys

docdir = sys.argv[1]
mds = [os.path.join(docdir, "README.md"), os.path.join(docdir, "PROTOCOL.md")]
sub = os.path.join(docdir, "docs")
mds += sorted(os.path.join(sub, f) for f in os.listdir(sub) if f.endswith(".md"))
missing = [p for p in mds if not os.path.isfile(p)]
assert not missing, missing
# uncompressed, or the links below cannot resolve
gz = [p + ".gz" for p in mds if os.path.exists(p + ".gz")]
assert not gz, gz

dead, links, repo_pointers, images = [], 0, [], 0
transcripts = sorted(
    f for f in (os.listdir(os.path.join(sub, "packaging"))
                if os.path.isdir(os.path.join(sub, "packaging")) else [])
    if f.endswith(".log") or f.endswith(".log.gz"))
docroot = os.path.realpath(docdir)
for path in mds:
    text = open(path, encoding="utf-8", errors="replace").read()
    found = [m.group(1) for m in re.finditer(r"!?(?:\[[^\]]*\])\(([^)\s]+)", text)]
    found += re.findall(r'<img[^>]+src="([^"]+)"', text)
    for dest in found:
        dest = dest.split("#", 1)[0]
        if not dest or dest.startswith(("http://", "https://", "mailto:", "file:")):
            continue
        where = os.path.realpath(os.path.join(os.path.dirname(path), dest))
        # images are the repository's showcase and are deliberately not packaged
        # (debian/rules says why: some of them are renders of XIGMATEK's library)
        if dest.endswith((".png", ".jpg", ".jpeg", ".gif", ".svg")):
            images += 1
            continue
        if dest.endswith((".md", ".log")):
            # what the package promises: every document and transcript the docs link
            # is installed, and the link resolves
            links += 1
            if not os.path.exists(where):
                dead.append((os.path.relpath(path, docdir), dest))
        elif not os.path.exists(where):
            # a pointer into the source repository - LICENSE, debian/copyright,
            # themes/alpha/ - which the package does not carry, and which the installed
            # prose explains rather than hides
            repo_pointers.append((os.path.relpath(path, docdir), dest))
assert not dead, dead
print(f"  documents           {len(mds)} markdown files under {docdir}, none compressed")
print(f"  links               {links} links inside the doc set, all resolving; "
      f"{images} image link(s) repo-only by design; "
      f"{len(repo_pointers)} pointer(s) into the source tree "
      f"({', '.join(sorted({d for _, d in repo_pointers}))})")
print(f"  transcripts         {len(transcripts)} kept log(s) under docs/packaging/, "
      f"so a cited claim has its file offline too")
PY

echo
echo "== the vendor library, if it is installed"
lib=/usr/share/xigmalcd/themes/alpha
if ! dpkg -s xigmatek-connect-lcd-themes >/dev/null 2>&1; then
    say "themes package" "not installed (Suggest-equivalent; SKIPPED)"
else
    test -f "$lib/manifest.json" || { echo "  missing $lib/manifest.json: FAILED"; exit 1; }
    # Every file the manifest recorded, hashed in the layout the package installed it
    # into: the same check tools/selftest.sh runs in a checkout, run here against the
    # bytes that actually got packaged.
    python3 - "$lib" <<'PY'
import hashlib, json, os, sys
lib = sys.argv[1]
man = json.load(open(os.path.join(lib, "manifest.json")))
bad, done, total = [], 0, 0
for ent in man["files"]:
    total += 1
    path = os.path.join(lib, ent["path"])
    if not os.path.exists(path):
        bad.append((ent["path"], "missing"))
        continue
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    if h.hexdigest() != ent["sha256"]:
        bad.append((ent["path"], h.hexdigest()[:16]))
    done += 1
extra = []
for root, _dirs, files in os.walk(lib):
    for name in files:
        rel = os.path.relpath(os.path.join(root, name), lib)
        if rel not in {e["path"] for e in man["files"]} and rel not in (
                "manifest.json", "README.md"):
            extra.append(rel)
assert not bad, bad[:6]
assert not extra, extra[:6]
print(f"  manifest          {done}/{total} files hashed clean under {lib}")
kinds = {}
for ent in man["files"]:
    kinds[ent["kind"]] = kinds.get(ent["kind"], 0) + 1
print(f"  kinds             {kinds}")
PY
    # Bytes on disk are only half of an installed library: the other half is whether the
    # program that ships beside it can *read* it on this machine.  So the same doors the loop
    # uses - `themes.scan()`, `themes.paint()`, `--list-themes` - run here against the
    # installed tree, with a pinned metrics dict and one pinned instant, and no port in
    # sight.  Nothing is asserted about the pixels themselves (the fonts an installed system
    # has are its own business, and the suite holds the pixel figures in a checkout); what is
    # asserted is the accounting identity, the refusal rule, and the pairing.
    python3 - "$lib" <<'PY'
import datetime, json, os, subprocess, sys

from xigmalcd import themes

PIN = {"cpu": {"temperature": 61, "load": 42, "power": 88.5, "speedAverage": 4338},
       "gpu": {"temperature": 55, "load": 63, "power": 37.0, "speed": 1500},
       "network": {"upload": 12.3, "download": 45.6}, "memory": {"load": 7}}
WHEN = datetime.datetime(2026, 11, 8, 3, 40, 0)

pick, rej = themes.scan()
lib = sys.argv[1]               # `python3 - "$lib"`, so the path arrives as argv
man = json.load(open(os.path.join(lib, "manifest.json")))
layouts = [e for e in man["files"] if e["path"].endswith(".json")
           and e["path"].startswith("layouts/")]
assert len(pick) + len(rej) == len(layouts), (
    len(pick), len(rej), len(layouts),
    "the installed library's layouts are not all accounted for by `themes.scan()`")
assert all(r["ratio"] == "1:1" for r in pick), [r["ratio"] for r in pick]
assert all(r["ratio"] != "1:1" for r in rej), [r["ratio"] for r in rej]
print(f"  installed selection {len(pick)} of the {len(layouts)} layouts in the manifest are "
      f"selectable here, {len(rej)} refused on their own `ratio` field "
      f"({', '.join(sorted({r['ratio'] for r in rej}))})")

painted, asks, faces = 0, {}, set()
for rec in pick:
    img, notes = themes.paint(rec, PIN, when=WHEN, scrim=0)
    src_skips = [m for m in notes["missing"] if not str(m).startswith("font:")]
    face_skips = [m for m in notes["missing"] if str(m).startswith("font:")]
    assert len(notes["boxes"]) + len(src_skips) + len(face_skips) == rec["widgets"], (
        rec["name"], rec["widgets"], notes["boxes"], notes["missing"],
        "a widget of an installed layout neither drew nor was reported: the accounting "
        "identity the checkout's suite holds does not hold on an installed system")
    assert notes["boxes"], (rec["name"], "an installed layout painted nothing at all")
    painted += len(notes["boxes"])
    for m in src_skips:
        asks[m] = asks.get(m, 0) + 1
    for m in face_skips:
        faces.add(str(m))
    assert img.size == (rec["w"], rec["h"]), (rec["name"], img.size, rec["w"],
                                             rec["h"])
print(f"  installed painting  {painted} widget boxes painted across the {len(pick)} "
      f"selectable layouts, from one pinned dict at one pinned instant, no port opened")
print(f"                      sources with no reading here: "
      + (", ".join(f"{k} in {v} layouts" for k, v in sorted(asks.items(),
                                                            key=lambda kv: -kv[1]))
         or "none") + f"; faces this machine lacks: {len(faces)}"
      + (f" ({', '.join(sorted(faces))})" if faces else ""))

# The pairing, on the machine that installed the themes package.  Every selectable
# layout names one clip, and the themes package installs that file beside the layout that
# names it - so the question an installed user actually hits is the other half: does
# the loop's rule for turning a bare name into a file (`main.media_roots()`, which is
# what `--mp4 NAME` and the session default go through) find it?  Since 0.4 the theme
# library is a root of that lookup, behind the media roots, so the answer is yes for
# all of them, and that is what this part of the test now checks.  Before the change the
# same code resolved 2 of the 23 by name.
from xigmalcd.main import find_media, media_roots
beside, resolvable = 0, []
for rec in pick:
    name, why = themes.pair(rec["name"])
    assert name and not why, (rec["name"], name, why)
    if os.path.isfile(os.path.join(lib, "clips", name)):
        beside += 1
    if os.path.basename(find_media(name)) == name and os.path.isfile(find_media(name)):
        resolvable.append(rec["name"])
assert beside == len(pick), (beside, len(pick),
                             "an installed layout names a clip the themes package did not "
                             "install beside it")
# Pinned at the count rather than printed and hoped: `media_roots()` carries the theme
# library - the installed copy, and this checkout's where a source tree is around - so
# a name `--list-themes` printed resolves through the loop as well.  The media roots
# still win where both kinds of root hold the same name, which is what keeps the
# session default exactly where it has always been.
assert len(resolvable) == len(pick), (
    sorted({r["name"] for r in pick} - set(resolvable)), len(pick),
    "an installed layout's declared clip no longer resolves by bare name through "
    "`main.media_roots()` - check that the theme library is still a root of it, and "
    "what each package installs under /usr/share/xigmalcd")
print(f"  installed pairing   all {len(pick)} selectable layouts name one clip and the themes "
      f"package installs {beside} of them under {lib}/clips; the loop's own name lookup "
      f"(`--mp4 NAME`) resolves {len(resolvable)} of {len(pick)}, through: "
      + ", ".join(media_roots()))

# and the CLI's own door says the same thing in the same digits
out = subprocess.run(["xigmalcd", "--list-themes"], capture_output=True, text=True)
assert out.returncode == 0, out.stderr[-400:]
for want in (f"{len(pick)}", f"{len(rej)}"):
    assert want in out.stdout, (want, out.stdout[:300])
for rec in pick[:5] + rej:
    assert rec["name"] in out.stdout, (rec["name"], out.stdout[:400])
print(f"  --list-themes       {len(out.stdout.splitlines())} lines, and it names the same "
      f"{len(pick)} + {len(rej)} split this run measured")
PY
    say "themes" "$lib, every manifest entry re-hashed, all of it read back by the shipped code"
fi

echo
echo "all installed checks passed"
