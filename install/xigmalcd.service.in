[Unit]
Description=Xigmatek Connect LCD - show system stats on the AIO's front panel
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@DIR@
ExecStartPre=/bin/sleep 5
# This one process is the only opener of the serial port, and it listens on a
# control socket while it draws: $XDG_RUNTIME_DIR/xigmalcd.sock, which systemd
# sets for a user unit.  That is how the desktop window and `python3 -m xigmalcd
# --status` reach the glass without stopping this unit - see xigmalcd/control.py.
# Add --allow-reset to ExecStart only if you want the socket to be able to send
# the vendor's `recovery` (it re-enumerates the USB device and drops the stored
# background); the deliberate way is the reset command run by hand -
# `xigmalcd-reset --yes` on a system that installed the package,
# `tools/reset_panel.py --yes` in a checkout, one module behind both
# (xigmalcd/reset.py).  A package install has no tools/ directory, which is why
# that command exists.
# Names no picture on purpose, exactly like the packaged unit (debian/xigmalcd.service):
# the theme, the background and the rate come from the saved choice in
# ${XDG_CONFIG_HOME:-~/.config}/xigmalcd/display.json, and with nothing saved the program's
# own defaults - alpha, Theme_25.mp4, 1 fps.  `install.sh` seeds that file from
# XIGMALCD_THEME / XIGMALCD_FPS when you set them, so the interface you know kept its
# meaning and only changed destination.
ExecStart=@PYTHON@ -m xigmalcd
Restart=on-failure
RestartSec=10
# the panel is a nicety, not a service: keep it off the way of real work
Nice=10

[Install]
WantedBy=default.target
