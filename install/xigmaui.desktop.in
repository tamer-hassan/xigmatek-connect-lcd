# install/install.sh fills @PYTHON@ and @DIR@ and writes this to
# $XDG_DATA_HOME/applications/xigmaui.desktop (usually ~/.local/share/...).
#
# `Path` is what makes `-m xigmaui` find the package: the working directory has
# to be the checkout.  `Icon` is given as a full path rather than a themed name:
# install/xigmaui.png is generated by tools/makeicon.py next to this file, and a
# path needs no icon tree, no cache and no theme to be configured.  (The window
# sets its own icon in app.py for the same reason.)
#
# One entry, because there is one program and it decides its own role: if a
# `xigmalcd` display is running (its control socket answers) the window drives it
# and never opens /dev/ttyACM0; if none is, it uses the port itself, one action at
# a time.  The box at the top of the window says which of the two it is.  The
# tray-only action below is the same program with `--hidden`, and it needs a
# desktop with a tray to be of any use: without one the window prints why and
# shows itself anyway.
#
# The name is the family, not the author's model.  Every measurement in this repo
# was taken on a Connect 360 (README, PROTOCOL.md), and the frame is drawn at
# 480x480 because that is what this panel reports - no other Connect has been
# tested - but a menu entry called "Connect 360" would tell an owner of a
# different Connect that this is not for their port, which is a claim nothing here
# has measured either.  `connect 360` stays in Keywords so that someone who does
# own one still finds it by typing their model.
[Desktop Entry]
Type=Application
Version=1.0
Name=Xigmatek Connect LCD
GenericName=AIO LCD panel
GenericName[en_US]=AIO LCD panel
Comment=Preview, theme and background picker for the Xigmatek Connect series AIO coolers LCD
Comment[en_US]=Preview, theme and background picker for the Xigmatek Connect series AIO coolers LCD
Exec=@PYTHON@ -m xigmaui
Path=@DIR@
Icon=@DIR@/install/xigmaui.png
Terminal=false
Categories=System;Monitor;Qt;
Keywords=xigmatek;connect;connect 360;xigma;xigmaui;aio;lcd;panel;cooling;monitor;
# StartupNotify=true is worth it for the window: the launcher marks it starting
# for the ~0.2 s the build takes.  It is why the tray-only action is an action and
# not a second visible entry: a shell that waits for a window with the right
# WM_CLASS waits in vain for `--hidden`, so on some desktops that entry would
# spin until it gave up.
StartupNotify=true
StartupWMClass=xigmaui
NoDisplay=false
Actions=tray;

# No `Path` here: the key is only legal in the main group, so the action has to
# move to the checkout itself.  Without that the action's `-m xigmaui` would run
# in whatever directory the launcher happened to use and find no such module.
[Desktop Action tray]
Name=Start in the tray only
Name[en_US]=Start in the tray only
Exec=sh -c "cd @DIR@ && exec @PYTHON@ -m xigmaui --hidden"
